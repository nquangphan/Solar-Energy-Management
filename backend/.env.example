# Backend là chủ sở hữu DB DUY NHẤT (AD-1). Chỉ backend giữ credential DB;
# web/mobile KHÔNG có biến này. Copy sang `.env` (gitignored) và điền giá trị thật.

# Prisma datasource — PostgreSQL 18.x
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phuong_nam_solar?schema=public"

# HTTP port cho Nest (mặc định 3000 nếu bỏ trống)
PORT=3000

# CORS (Story 10.3): danh sách origin web được gọi API, cách nhau dấu phẩy, khớp nguyên chuỗi
# (vd `https://app.example.vn`). Để trống ⇒ TẮT CORS — dev dùng proxy vite (cùng origin) nên không cần.
CORS_ORIGINS=

# --- Auth (Story 2.3) ---
# Secret ký JWT access token. PHẢI ≥32 ký tự ngẫu nhiên (main.ts fail-fast nếu thiếu/ngắn).
# Sinh 1 chuỗi thật cho `.env` local, vd: `openssl rand -base64 48`. KHÔNG commit secret thật.
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# TTL access token (JWT), định dạng 15m/1h/3600s/1d. Mặc định 15m.
ACCESS_TOKEN_TTL=15m
# TTL refresh token tính bằng ngày. Mặc định 30.
REFRESH_TOKEN_TTL_DAYS=30

# --- Đặt lại mật khẩu (Story 2.8) ---
# Vòng đời mã xác thực 6 số, tính bằng phút. Cũng là cooldown gửi lại mã. Mặc định 5.
PASSWORD_RESET_CODE_TTL_MINUTES=5
# Số lần nhập sai tối đa trước khi mã bị khoá. Mặc định 5.
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- Seed admin đầu tiên (prisma db seed) ---
# Tài khoản admin để đăng nhập được lúc dev. Đọc từ env — KHÔNG hardcode trong repo.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-thanh-mat-khau-manh
# Story 2.4: đánh dấu account seed trên là Super Admin → được cấp preset SUPER_ADMIN
# (gồm quyền `audit.read`, AC-3). Chỉ MỘT account nên bật cờ này. Mặc định không cấp.
SEED_ADMIN_IS_SUPER_ADMIN=true

# --- Xuất & chia sẻ báo giá (Story 4.8) ---
# File/ảnh báo giá lưu Cloudflare R2 (AD-3), KHÔNG lưu đĩa VPS. Adapter lazy-init: vắng
# TOÀN BỘ 4 biến R2 thì storage tự bỏ qua (test hermetic không chạm R2); có thì cần ĐỦ 4.
# R2_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Đặt =1 khi chạy Puppeteer (render PDF/ảnh báo giá) trong container/VPS thiếu sandbox
# (Chromium cần --no-sandbox khi không có user namespace). Để trống ở máy dev bình thường.
PUPPETEER_NO_SANDBOX=
