# Backend là chủ sở hữu DB DUY NHẤT (AD-1). Chỉ backend giữ credential DB;
# web/mobile KHÔNG có biến này. Copy sang `.env` (gitignored) và điền giá trị thật.

# Prisma datasource — PostgreSQL 18.x
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phuong_nam_solar?schema=public"

# HTTP port cho Nest (mặc định 3000 nếu bỏ trống)
PORT=3000
