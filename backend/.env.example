# Backend là chủ sở hữu DB DUY NHẤT (AD-1). Chỉ backend giữ credential DB;
# web/mobile KHÔNG có biến này. Copy sang `.env` (gitignored) và điền giá trị thật.

# Prisma datasource — PostgreSQL 18.x
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/phuong_nam_solar?schema=public"

# HTTP port cho Nest (mặc định 3000 nếu bỏ trống)
PORT=3000

# --- Auth (Story 2.3) ---
# Secret ký JWT access token. PHẢI ≥32 ký tự ngẫu nhiên (main.ts fail-fast nếu thiếu/ngắn).
# Sinh 1 chuỗi thật cho `.env` local, vd: `openssl rand -base64 48`. KHÔNG commit secret thật.
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# TTL access token (JWT), định dạng 15m/1h/3600s/1d. Mặc định 15m.
ACCESS_TOKEN_TTL=15m
# TTL refresh token tính bằng ngày. Mặc định 30.
REFRESH_TOKEN_TTL_DAYS=30

# --- Seed admin đầu tiên (prisma db seed) ---
# Tài khoản admin để đăng nhập được lúc dev. Đọc từ env — KHÔNG hardcode trong repo.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-thanh-mat-khau-manh
