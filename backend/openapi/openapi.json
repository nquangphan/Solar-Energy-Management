{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Backend còn sống và kết nối được DB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin đăng nhập (UNAUTHENTICATED, message generic).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cấp access token mới (rotate).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token sai/hết hạn/đã thu hồi (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Thu hồi phiên (idempotent, trung tính)."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Luôn 200 với cùng một body, dù email tồn tại hay không (chống dò email hợp lệ).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPasswordResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Mật khẩu đã đổi, mã đã tiêu thụ, mọi phiên đã bị thu hồi."
          },
          "401": {
            "description": "Mã sai/hết hạn/đã dùng/vượt số lần thử, hoặc email lạ (UNAUTHENTICATED, một message duy nhất).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/change-password": {
      "post": {
        "operationId": "ChangePasswordController_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequestDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Mật khẩu đã đổi; mọi phiên (kể cả phiên hiện tại) đã bị thu hồi."
          },
          "400": {
            "description": "Mật khẩu mới không đạt chính sách hoặc trùng mật khẩu hiện tại (VALIDATION_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu access token, hoặc mật khẩu hiện tại không đúng (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Danh tính + bộ quyền hiệu lực (sorted) của phiên đang đăng nhập.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/products": {
      "post": {
        "operationId": "ProductsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sản phẩm đã tạo. `costPrice` chỉ có mặt nếu caller có costs.view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Body không hợp lệ (VALIDATION_ERROR) — kèm `fieldErrors`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "403": {
            "description": "Thiếu catalog.manage; hoặc body có `costPrice` mà thiếu costs.view (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "catalog"
        ]
      },
      "get": {
        "operationId": "ProductsController_findAll",
        "parameters": [
          {
            "name": "includeInactive",
            "required": false,
            "in": "query",
            "description": "true = trả cả sản phẩm đã ẩn (soft-delete). Mặc định chỉ sản phẩm còn hiệu lực.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponseDto"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Thiếu catalog.manage (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "ProductsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Thiếu catalog.manage (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "Không có sản phẩm với id này (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "catalog"
        ]
      },
      "patch": {
        "operationId": "ProductsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sản phẩm sau khi sửa. Sửa giá KHÔNG hồi tố đơn đã chốt (đơn giữ giá snapshot riêng).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Body không hợp lệ (VALIDATION_ERROR) — kèm `fieldErrors`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "403": {
            "description": "Thiếu catalog.manage; hoặc body có `costPrice` mà thiếu costs.view (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "Không có sản phẩm với id này (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "catalog"
        ]
      },
      "delete": {
        "operationId": "ProductsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sản phẩm đã bị ẩn khỏi danh mục (soft-delete, không xoá bản ghi)."
          },
          "403": {
            "description": "Thiếu catalog.manage (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "Không có sản phẩm với id này (NOT_FOUND).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "catalog"
        ]
      }
    }
  },
  "info": {
    "title": "Phương Nam Solar API",
    "description": "Hợp đồng API cross-repo cho web + mobile. Spec SINH TỪ code NestJS — CẤM SỬA TAY.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Trạng thái tổng thể của backend.",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "description": "Kết quả ping DB qua PrismaService (chứng minh wiring AD-1).",
            "example": "up",
            "enum": [
              "up"
            ]
          },
          "timestamp": {
            "type": "string",
            "description": "Thời điểm phản hồi, ISO-8601 UTC (client hiển thị UTC+7).",
            "example": "2026-07-08T09:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email đăng nhập.",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu.",
            "example": "MatKhauManh!23"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token ngắn hạn (stateless; guard Story 2.5 verify)."
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token opaque — gửi tới POST /auth/refresh để lấy access token mới (rotate)."
          },
          "expiresIn": {
            "type": "number",
            "description": "Số giây access token còn hiệu lực.",
            "example": 900
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Tên field bị lỗi (khớp property của DTO).",
            "example": "email"
          },
          "code": {
            "type": "string",
            "description": "Mã lỗi field (constraint key của class-validator, vd \"isEmail\"), string ổn định để FE map.",
            "example": "isEmail"
          },
          "message": {
            "type": "string",
            "description": "Mô tả người đọc được, có thể đổi/đa ngôn ngữ.",
            "example": "email phải là địa chỉ email hợp lệ"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã lỗi string từ enum có tài liệu (ErrorCode). FE map lỗi theo mã này, KHÔNG theo message.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "Mô tả lỗi người đọc được (có thể đổi/đa ngôn ngữ).",
            "example": "Dữ liệu không hợp lệ"
          },
          "fieldErrors": {
            "description": "Danh sách lỗi cấp field (chỉ có ở lỗi validation). Vắng mặt với lỗi không phải validation.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "traceId": {
            "type": "string",
            "description": "ID lần lỗi (UUID v4 hoặc x-request-id) — dùng để tra log server-side cùng sự cố.",
            "example": "3f2b0c9e-8a1d-4e2f-9c7a-1b2c3d4e5f60"
          }
        },
        "required": [
          "code",
          "message",
          "traceId"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token đã cấp lúc đăng nhập/refresh trước."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token của phiên cần thu hồi."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email đã đăng ký của tài khoản cần đặt lại mật khẩu.",
            "example": "admin@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordResponseDto": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "number",
            "description": "Số giây mã xác thực còn hiệu lực. Hằng số từ config — không tiết lộ tài khoản có tồn tại hay không.",
            "example": 300
          }
        },
        "required": [
          "expiresInSeconds"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email đã đăng ký (cùng email đã yêu cầu mã).",
            "example": "admin@example.com"
          },
          "code": {
            "type": "string",
            "description": "Mã xác thực 6 chữ số đã nhận.",
            "example": "000000"
          },
          "newPassword": {
            "type": "string",
            "description": "Mật khẩu mới. Tối thiểu 8 ký tự, có chữ và số.",
            "example": "MatKhauMoi123"
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "Mật khẩu hiện tại — bắt buộc để một phiên bị chiếm không tự đổi được.",
            "example": "MatKhauCu123"
          },
          "newPassword": {
            "type": "string",
            "description": "Mật khẩu mới. Tối thiểu 8 ký tự, có chữ và số. Phải khác mật khẩu hiện tại.",
            "example": "MatKhauMoi456"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID account (UUID)."
          },
          "email": {
            "type": "string",
            "description": "Email đăng nhập."
          },
          "displayName": {
            "type": "string",
            "description": "Tên hiển thị."
          },
          "permissions": {
            "description": "Bộ quyền hiệu lực (sorted, tất định), mỗi phần tử là một key trong `openapi/permissions.json`; FE dựng `PermissionSet` từ mảng này.",
            "example": [
              "audit.read",
              "orders.view_all"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "permissions"
        ]
      },
      "CreateProductRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tên vật tư.",
            "example": "Tấm pin JA Solar 580W"
          },
          "sku": {
            "type": "string",
            "description": "Mã vật tư — duy nhất.",
            "example": "JAS-580-M10"
          },
          "unit": {
            "type": "string",
            "description": "Đơn vị tính.",
            "example": "tấm"
          },
          "price": {
            "type": "number",
            "description": "Giá bán — số nguyên ĐỒNG (không thập phân).",
            "example": 2450000
          },
          "costPrice": {
            "type": "number",
            "description": "Giá vốn — số nguyên ĐỒNG. Ghi được CHỈ khi có quyền costs.view; thiếu quyền mà gửi field này ⇒ 403. Bỏ trống ⇒ 0 (từ Story 6.3 hệ thống tự cập nhật bằng bình quân gia quyền khi nhập kho).",
            "example": 1950000
          },
          "tracksStock": {
            "type": "boolean",
            "description": "Có theo dõi tồn kho không (pin/inverter = true; công lắp, phí vận chuyển = false).",
            "default": true
          },
          "priceEditable": {
            "type": "boolean",
            "description": "Cho phép sửa giá tại chỗ lúc lập báo giá (phí lắp đặt = true; tấm pin = false).",
            "default": false
          },
          "warrantyMonths": {
            "type": "object",
