// Prisma schema — Phương Nam Solar backend.
//
// AD-1: Backend là chủ sở hữu DB DUY NHẤT. Credential DB chỉ nằm ở `.env`
// (gitignored) qua `DATABASE_URL`; web/mobile KHÔNG có đường/biến chạm DB.
//
// Prisma 7 bỏ engine Rust mặc định → dùng driver adapter (`@prisma/adapter-pg`):
//  - Runtime: `PrismaService` truyền adapter cho `PrismaClient` (đọc DATABASE_URL).
//  - CLI/migrate: connection URL khai ở `prisma.config.ts` (datasource.url = env).
// Vì vậy datasource block ở đây CHỈ khai `provider` (Prisma 7 không cho `url` ở schema).
//
// Story 2.3 (Đăng nhập JWT) khai model ĐẦU TIÊN của dự án: `Account` (danh tính) +
// `Session` (refresh token thu hồi được) + migration đầu tiên. Đây là chủ ý ĐÈ ghi
// chú cũ của skeleton 2.1 ("Account thuộc 2.4"): login (2.3) cần danh tính TRƯỚC
// quyền (2.4). `Account` ở đây là BASE tối giản (chỉ field xác thực); Story 2.4 MỞ
// RỘNG cùng entity này với registry quyền + `AccountPermission` (migration riêng,
// KHÔNG tạo lại bảng) — một entity, hai story bồi đắp, KHÔNG hai nhánh danh tính (AD-8).
//
// Convention (xem CONVENTIONS.md): entity PascalCase → bảng snake_case số nhiều (@@map);
// cột snake_case (@map). ID UUID v4.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Chủ sở hữu danh tính đăng nhập (AD-8). BASE tối giản cho xác thực ở 2.3; quyền
/// (registry + AccountPermission) do Story 2.4 mở rộng — KHÔNG thêm cột quyền ở đây.
model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  permissions  AccountPermission[]
  passwordResetCodes PasswordResetCode[]

  @@map("accounts")
}

/// Quyền lưu THEO account — nguồn chân lý RBAC per-account (AD-8). Join
/// `account_id × permission`; `permission` là một `PermissionKey` (registry
/// `accounts/domain`) lưu kiểu **String**, validate ở tầng app (`setForAccount`) — KHÔNG
/// Postgres-enum để registry evolve không cần migration enum mỗi lần thêm key (nhất quán
/// ERD "string status"). Story 2.4 CHỈ thêm bảng này; KHÔNG tạo lại `accounts`/`sessions`.
model AccountPermission {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([accountId, permission])
  @@index([accountId])
  @@map("account_permissions")
}

/// Nhật ký kiểm toán BẤT BIẾN, append-only (AD-8, spine "AuditLog append-only").
/// Ghi bởi AuditSubscriber khi có domain event; đọc CHỈ Super Admin (endpoint read = Story 8.5).
/// `actorAccountId` lưu dạng String (KHÔNG FK cascade) để bản ghi lịch sử SỐNG SÓT khi
/// account bị vô hiệu/xoá — audit là snapshot bất biến, không đổi theo vòng đời account.
model AuditLog {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")          // "gì"
  actorAccountId String?  @map("actor_account_id")     // "ai" (null = system/auto)
  targetType     String?  @map("target_type")          // "đối tượng" — loại
  targetId       String?  @map("target_id")            // "đối tượng" — id
  before         Json? // "trước"
  after          Json? // "sau"
  occurredAt     DateTime @map("occurred_at") // "khi nào" (thời điểm nghiệp vụ)
  createdAt      DateTime @default(now()) @map("created_at") // khi ghi (server)

  @@index([actorAccountId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Mã đặt lại mật khẩu — LƯU HASH, không bao giờ lưu/đọc mã thô (mirror Session.refreshTokenHash,
/// AD-12). Mã entropy thấp (6 chữ số ≈ 20 bit) ⇒ an toàn dựa vào: TTL ngắn + single-use
/// (`consumedAt`) + trần số lần thử (`attemptCount`) + response trung tính. Vì entropy thấp,
/// hash bằng argon2id (KHÔNG SHA-256): nếu DB bị đọc, fast-hash của 10⁶ khả năng vỡ tức thì.
/// Tra cứu theo `accountId` (KHÔNG theo hash) — argon2 salt ngẫu nhiên nên hash không tra được,
/// và mã 6 số có thể trùng nhau giữa các account.
model PasswordResetCode {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash     String    @map("code_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("password_reset_codes")
}

/// Vật tư trong danh mục (FR-14). Giá bán `price` và giá vốn `costPrice` là **Int đồng**
/// (AD-10/AD-16) — KHÔNG Float/Decimal: tiền tính bằng số nguyên, làm tròn là quyết định
/// nghiệp vụ tường minh, không phải nhiễu dấu phẩy động.
///
/// `costPrice` là giá vốn HIỆN HÀNH, KHÔNG phải snapshot: đơn đã chốt đóng băng giá riêng
/// (`OrderLineItem.unitPriceSnapshot` lúc chốt, `costPriceSnapshot` lúc xuất kho — AD-20),
/// nên sửa giá ở đây KHÔNG hồi tố đơn cũ. Đọc/ghi `costPrice` gate bởi quyền `costs.view`
/// ở tầng app (AD-4) — DB không biết quyền.
///
/// Xoá = soft-delete (`isActive = false`), KHÔNG hard-delete: Epic 4 (`OrderLineItem`) và
/// Epic 6 (`StockItem`) sẽ FK vào bảng này; xoá cứng sẽ mồ côi dòng đơn/tồn kho lịch sử.
///
/// `tracksStock` = có theo dõi tồn (pin/inverter = true; công lắp/phí vận chuyển = false).
/// `priceEditable` = sale sửa được giá tại chỗ (phí lắp đặt = true; tấm pin = false —
/// mặc định an toàn, vì sửa giá là cửa sau né duyệt chiết khấu).
/// `warrantyMonths` nullable CÓ CHỦ ĐÍCH (công lắp không có bảo hành) — KHÔNG validate chặn null.
model Product {
  id             String   @id @default(uuid())
  name           String
  sku            String   @unique
  unit           String
  price          Int
  costPrice      Int      @map("cost_price")
  tracksStock    Boolean  @default(true) @map("tracks_stock")
  priceEditable  Boolean  @default(false) @map("price_editable")
  warrantyMonths Int?     @map("warranty_months")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("products")
}

/// Phiên đăng nhập — nơi refresh token sống để THU HỒI ĐƯỢC (AD-12). Chỉ lưu HASH
/// của refresh token (KHÔNG lưu token thô). Logout/rotate set `revokedAt`.
model Session {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("sessions")
}
