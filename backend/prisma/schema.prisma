// Prisma schema — Phương Nam Solar backend.
//
// AD-1: Backend là chủ sở hữu DB DUY NHẤT. Credential DB chỉ nằm ở `.env`
// (gitignored) qua `DATABASE_URL`; web/mobile KHÔNG có đường/biến chạm DB.
//
// Prisma 7 bỏ engine Rust mặc định → dùng driver adapter (`@prisma/adapter-pg`):
//  - Runtime: `PrismaService` truyền adapter cho `PrismaClient` (đọc DATABASE_URL).
//  - CLI/migrate: connection URL khai ở `prisma.config.ts` (datasource.url = env).
// Vì vậy datasource block ở đây CHỈ khai `provider` (Prisma 7 không cho `url` ở schema).
//
// Story 2.3 (Đăng nhập JWT) khai model ĐẦU TIÊN của dự án: `Account` (danh tính) +
// `Session` (refresh token thu hồi được) + migration đầu tiên. Đây là chủ ý ĐÈ ghi
// chú cũ của skeleton 2.1 ("Account thuộc 2.4"): login (2.3) cần danh tính TRƯỚC
// quyền (2.4). `Account` ở đây là BASE tối giản (chỉ field xác thực); Story 2.4 MỞ
// RỘNG cùng entity này với registry quyền + `AccountPermission` (migration riêng,
// KHÔNG tạo lại bảng) — một entity, hai story bồi đắp, KHÔNG hai nhánh danh tính (AD-8).
//
// Convention (xem CONVENTIONS.md): entity PascalCase → bảng snake_case số nhiều (@@map);
// cột snake_case (@map). ID UUID v4.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Chủ sở hữu danh tính đăng nhập (AD-8). BASE tối giản cho xác thực ở 2.3; quyền
/// (registry + AccountPermission) do Story 2.4 mở rộng — KHÔNG thêm cột quyền ở đây.
model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  permissions  AccountPermission[]
  passwordResetCodes PasswordResetCode[]

  @@map("accounts")
}

/// Quyền lưu THEO account — nguồn chân lý RBAC per-account (AD-8). Join
/// `account_id × permission`; `permission` là một `PermissionKey` (registry
/// `accounts/domain`) lưu kiểu **String**, validate ở tầng app (`setForAccount`) — KHÔNG
/// Postgres-enum để registry evolve không cần migration enum mỗi lần thêm key (nhất quán
/// ERD "string status"). Story 2.4 CHỈ thêm bảng này; KHÔNG tạo lại `accounts`/`sessions`.
model AccountPermission {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([accountId, permission])
  @@index([accountId])
  @@map("account_permissions")
}

/// Nhật ký kiểm toán BẤT BIẾN, append-only (AD-8, spine "AuditLog append-only").
/// Ghi bởi AuditSubscriber khi có domain event; đọc CHỈ Super Admin (endpoint read = Story 8.5).
/// `actorAccountId` lưu dạng String (KHÔNG FK cascade) để bản ghi lịch sử SỐNG SÓT khi
/// account bị vô hiệu/xoá — audit là snapshot bất biến, không đổi theo vòng đời account.
model AuditLog {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")          // "gì"
  actorAccountId String?  @map("actor_account_id")     // "ai" (null = system/auto)
  targetType     String?  @map("target_type")          // "đối tượng" — loại
  targetId       String?  @map("target_id")            // "đối tượng" — id
  before         Json? // "trước"
  after          Json? // "sau"
  occurredAt     DateTime @map("occurred_at") // "khi nào" (thời điểm nghiệp vụ)
  createdAt      DateTime @default(now()) @map("created_at") // khi ghi (server)

  @@index([actorAccountId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Mã đặt lại mật khẩu — LƯU HASH, không bao giờ lưu/đọc mã thô (mirror Session.refreshTokenHash,
/// AD-12). Mã entropy thấp (6 chữ số ≈ 20 bit) ⇒ an toàn dựa vào: TTL ngắn + single-use
/// (`consumedAt`) + trần số lần thử (`attemptCount`) + response trung tính. Vì entropy thấp,
/// hash bằng argon2id (KHÔNG SHA-256): nếu DB bị đọc, fast-hash của 10⁶ khả năng vỡ tức thì.
/// Tra cứu theo `accountId` (KHÔNG theo hash) — argon2 salt ngẫu nhiên nên hash không tra được,
/// và mã 6 số có thể trùng nhau giữa các account.
model PasswordResetCode {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash     String    @map("code_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("password_reset_codes")
}

/// Vật tư trong danh mục (FR-14). Giá bán `price` và giá vốn `costPrice` là **Int đồng**
/// (AD-10/AD-16) — KHÔNG Float/Decimal: tiền tính bằng số nguyên, làm tròn là quyết định
/// nghiệp vụ tường minh, không phải nhiễu dấu phẩy động.
///
/// `costPrice` là giá vốn HIỆN HÀNH, KHÔNG phải snapshot: đơn đã chốt đóng băng giá riêng
/// (`OrderLineItem.unitPriceSnapshot` lúc chốt, `costPriceSnapshot` lúc xuất kho — AD-20),
/// nên sửa giá ở đây KHÔNG hồi tố đơn cũ. Đọc/ghi `costPrice` gate bởi quyền `costs.view`
/// ở tầng app (AD-4) — DB không biết quyền.
///
/// Xoá = soft-delete (`isActive = false`), KHÔNG hard-delete: Epic 4 (`OrderLineItem`) và
/// Epic 6 (`StockItem`) sẽ FK vào bảng này; xoá cứng sẽ mồ côi dòng đơn/tồn kho lịch sử.
///
/// `tracksStock` = có theo dõi tồn (pin/inverter = true; công lắp/phí vận chuyển = false).
/// `priceEditable` = sale sửa được giá tại chỗ (phí lắp đặt = true; tấm pin = false —
/// mặc định an toàn, vì sửa giá là cửa sau né duyệt chiết khấu).
/// `warrantyMonths` nullable CÓ CHỦ ĐÍCH (công lắp không có bảo hành) — KHÔNG validate chặn null.
model Product {
  id             String         @id @default(uuid())
  name           String
  sku            String         @unique
  unit           String
  price          Int
  costPrice      Int            @map("cost_price")
  tracksStock    Boolean        @default(true) @map("tracks_stock")
  priceEditable  Boolean        @default(false) @map("price_editable")
  warrantyMonths Int?           @map("warranty_months")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  prices         ProductPrice[]
  groupItems     ProductGroupItem[]

  @@map("products")
}

/// Bậc thang giá theo SỐ LƯỢNG (FR-15). `minQty` = mua TỪ bao nhiêu trở lên thì ăn mức này;
/// `price` là **Int đồng** (AD-10), như `Product.price`.
///
/// Bất biến `minQty >= 2` (ràng ở tầng app, DTO): giá gốc `Product.price` CHÍNH LÀ mức
/// `minQty = 1` ngầm định. Cho phép một dòng `minQty = 1` ở đây sẽ tạo HAI nguồn chân lý cho
/// giá gốc — và bất biến "cờ TẮT ⇒ mỗi sản phẩm một giá duy nhất" vỡ ngay.
///
/// KHÔNG có cột giá vốn: giá vốn là MỘT con số duy nhất trên `Product` (Story 6.3 ghi đè bằng
/// bình quân gia quyền lúc nhập kho). Bậc thang không nhân giá vốn lên (AD-20).
///
/// Hard-delete an toàn (khác `Product` soft-delete): báo cáo lợi nhuận chỉ đọc snapshot đã
/// đóng băng trên dòng đơn (`unitPriceSnapshot`/`costPriceSnapshot`), KHÔNG bao giờ join ngược
/// về đây. Bậc thang là nguồn PHÂN GIẢI LÚC ĐỌC, không phải dữ liệu lịch sử ⇒ `onDelete: Cascade`.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int      @map("min_qty")
  price     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, minQty])
  @@index([productId])
  @@map("product_prices")
}

/// Gói vật tư = một CHECKLIST sản phẩm con có thứ tự, KHÔNG phải một sản phẩm và KHÔNG phải một
/// dòng tự do. Người dựng báo giá chọn gói → tick từng món → mỗi món tick thành một dòng báo giá
/// bình thường trỏ vào `Product` THẬT.
///
/// Gói KHÔNG BAO GIỜ được lưu lên Đơn: không snapshot, không in PDF, không cột `productGroupId`
/// trên bảng đơn nào. Nó là công cụ NHẬP LIỆU, không phải dữ liệu của đơn hàng. Hệ quả: không
/// bảng nào FK vào đây ngoài `product_group_items`, nên bảng này không cần seed (danh mục gói
/// bắt đầu rỗng) và xoá cứng một gói cũng không mồ côi dữ liệu lịch sử nào.
///
/// `isActive` (soft-delete) theo quy ước của module `catalog/` — cùng khuôn `Product.isActive`,
/// KHÔNG phải `active` của `CustomerSource`. Tắt gói để rút nó khỏi picker mà vẫn bật lại được
/// theo mùa.
model ProductGroup {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  items       ProductGroupItem[]

  @@map("product_groups")
}

/// Một món trong gói — CHỈ trỏ `productId` + thứ tự hiện trên checklist.
///
/// KHÔNG có `defaultQty`/`qty`/`price`: số lượng do người dùng tự gõ lúc dựng báo giá, và giá là
/// giá của chính `Product` × số lượng. KHÔNG có giá trọn gói. Thêm cột định mức ở đây là mở cửa
/// cho BOM — thứ nằm NGOÀI phạm vi MVP.
///
/// `@@unique([productGroupId, productId])`: một sản phẩm không nằm hai lần trong cùng một gói
/// (tick hai lần cùng một món là vô nghĩa). Một sản phẩm VẪN nằm được ở NHIỀU gói khác nhau.
///
/// `onDelete: Cascade` trên gói — item không có đời sống riêng ngoài gói của nó (khuôn
/// `ProductPrice`). `onDelete: Restrict` trên sản phẩm — xoá cứng một `Product` đang nằm trong
/// gói phải bị CHẶN, kẻo checklist trỏ vào hư không.
model ProductGroupItem {
  id             String       @id @default(uuid())
  productGroupId String       @map("product_group_id")
  group          ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  displayOrder   Int          @map("display_order")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([productGroupId, productId])
  @@index([productGroupId])
  @@map("product_group_items")
}

/// Cờ tính năng cấp NGHIỆP VỤ, sống trên DB — KHÔNG Firebase Remote Config (AD-14: Remote
/// Config chỉ dành cho config cấp app của mobile; cờ nghiệp vụ là nguồn chân lý của backend).
///
/// Tên cờ CHÍNH LÀ khoá chính — không có cột `id` uuid riêng: một cờ là một cái tên, và
/// registry `feature-flags/domain/feature-flag-registry.ts` là nơi duy nhất khai tên đó.
///
/// VẮNG DÒNG = TẮT (fail-closed). Mặc định tắt là hệ quả của việc KHÔNG có dòng, không phải
/// một dòng seed phải nhớ tạo — bật cờ = `upsert`. Vì vậy bảng này rỗng lúc khởi tạo hệ thống
/// và điều đó là ĐÚNG, không phải thiếu seed.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Nguồn khách — khách đến từ đâu (Facebook, Zalo, Đại lý…). Danh mục cấu hình được, seed 5
/// dòng ở story này; CRUD + màn cấu hình thuộc Story 3.5 (KHÔNG tạo lại bảng này ở đó).
///
/// `isOther` = CỜ nhận biết nguồn "Khác" — luật "chọn Khác thì bắt buộc ghi rõ" (`sourceNote`)
/// đọc CỜ này, KHÔNG so chuỗi `name === 'Khác'`: đổi tên hiển thị không được phép làm sập một
/// luật nghiệp vụ. Đúng MỘT dòng mang cờ này.
///
/// `sortOrder` để form khách hiển thị theo thứ tự nghiệp vụ, không theo thứ tự chèn.
model CustomerSource {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @map("sort_order")
  isOther     Boolean    @default(false) @map("is_other")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  customers   Customer[]

  @@map("customer_sources")
}

/// Khách hàng (FR-29). KHOÁ CHÍNH là **SĐT đã chuẩn hoá E.164** (`+84…`) — ngoại lệ DUY NHẤT
/// của quy ước "id UUID v4" (spine Conventions): một SĐT = một khách, trên toàn hệ thống.
/// Chuẩn hoá xảy ra ở backend qua `customers/domain/phone.ts` TRƯỚC khi chạm DB (AD-9); PK ở
/// đây vì vậy vừa là danh tính vừa là ràng buộc chống trùng — DB tự chặn, không phụ thuộc một
/// câu `if` ở tầng app nhớ chạy.
///
/// Hai LOẠI khách dùng CHUNG một bảng, cột nullable theo loại: `name`/`address` có ở cả hai;
/// `cccd` chỉ Cá nhân; `taxCode`/`bankAccount` chỉ Thương mại. Ràng buộc chéo-field (gửi
/// `taxCode` cho khách Cá nhân ⇒ 400) enforce ở TẦNG APP — DB không biết loại khách.
///
/// `custType` lưu **String** + validate `@IsIn` ở tầng app, KHÔNG Postgres enum — nhất quán
/// với `AccountPermission.permission`: registry evolve không cần migration enum.
///
/// `sourceId` BẮT BUỘC, không có mặc định: "khách này ở đâu ra" là câu hỏi nghiệp vụ phải trả
/// lời lúc tạo, không phải thứ hệ thống đoán hộ. Story 4.1 sẽ SNAPSHOT giá trị này sang
/// `Order.sourceId` lúc chốt đơn (khách quay lại qua kênh khác thì đơn cũ vẫn giữ kênh đã mang
/// nó về) — nên ở đây nó luôn có giá trị để copy.
model Customer {
  sdt         String         @id
  custType    String         @map("cust_type")
  name        String
  cccd        String?
  taxCode     String?        @map("tax_code")
  address     String?
  bankAccount String?        @map("bank_account")
  sourceId    String         @map("source_id")
  source      CustomerSource @relation(fields: [sourceId], references: [id])
  sourceNote  String?        @map("source_note")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([sourceId])
  @@map("customers")
}

/// Phiên đăng nhập — nơi refresh token sống để THU HỒI ĐƯỢC (AD-12). Chỉ lưu HASH
/// của refresh token (KHÔNG lưu token thô). Logout/rotate set `revokedAt`.
model Session {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("sessions")
}
