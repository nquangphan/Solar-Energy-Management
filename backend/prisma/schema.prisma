// Prisma schema — Phương Nam Solar backend.
//
// AD-1: Backend là chủ sở hữu DB DUY NHẤT. Credential DB chỉ nằm ở `.env`
// (gitignored) qua `DATABASE_URL`; web/mobile KHÔNG có đường/biến chạm DB.
//
// Prisma 7 bỏ engine Rust mặc định → dùng driver adapter (`@prisma/adapter-pg`):
//  - Runtime: `PrismaService` truyền adapter cho `PrismaClient` (đọc DATABASE_URL).
//  - CLI/migrate: connection URL khai ở `prisma.config.ts` (datasource.url = env).
// Vì vậy datasource block ở đây CHỈ khai `provider` (Prisma 7 không cho `url` ở schema).
//
// Story 2.3 (Đăng nhập JWT) khai model ĐẦU TIÊN của dự án: `Account` (danh tính) +
// `Session` (refresh token thu hồi được) + migration đầu tiên. Đây là chủ ý ĐÈ ghi
// chú cũ của skeleton 2.1 ("Account thuộc 2.4"): login (2.3) cần danh tính TRƯỚC
// quyền (2.4). `Account` ở đây là BASE tối giản (chỉ field xác thực); Story 2.4 MỞ
// RỘNG cùng entity này với registry quyền + `AccountPermission` (migration riêng,
// KHÔNG tạo lại bảng) — một entity, hai story bồi đắp, KHÔNG hai nhánh danh tính (AD-8).
//
// Convention (xem CONVENTIONS.md): entity PascalCase → bảng snake_case số nhiều (@@map);
// cột snake_case (@map). ID UUID v4.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Chủ sở hữu danh tính đăng nhập (AD-8). BASE tối giản cho xác thực ở 2.3; quyền
/// (registry + AccountPermission) do Story 2.4 mở rộng — KHÔNG thêm cột quyền ở đây.
model Account {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  permissions  AccountPermission[]
  passwordResetCodes PasswordResetCode[]
  ownedOrders    Order[] @relation("OrderOwner")
  assignedOrders Order[] @relation("OrderAssignee")
  discountRequests    DiscountApproval[] @relation("DiscountRequestedBy")
  discountResolutions DiscountApproval[] @relation("DiscountResolvedBy")
  quoteExports        QuoteExport[]      @relation("QuoteExportCreatedBy")

  @@map("accounts")
}

/// Quyền lưu THEO account — nguồn chân lý RBAC per-account (AD-8). Join
/// `account_id × permission`; `permission` là một `PermissionKey` (registry
/// `accounts/domain`) lưu kiểu **String**, validate ở tầng app (`setForAccount`) — KHÔNG
/// Postgres-enum để registry evolve không cần migration enum mỗi lần thêm key (nhất quán
/// ERD "string status"). Story 2.4 CHỈ thêm bảng này; KHÔNG tạo lại `accounts`/`sessions`.
model AccountPermission {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([accountId, permission])
  @@index([accountId])
  @@map("account_permissions")
}

/// Nhật ký kiểm toán BẤT BIẾN, append-only (AD-8, spine "AuditLog append-only").
/// Ghi bởi AuditSubscriber khi có domain event; đọc CHỈ Super Admin (endpoint read = Story 8.5).
/// `actorAccountId` lưu dạng String (KHÔNG FK cascade) để bản ghi lịch sử SỐNG SÓT khi
/// account bị vô hiệu/xoá — audit là snapshot bất biến, không đổi theo vòng đời account.
model AuditLog {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")          // "gì"
  actorAccountId String?  @map("actor_account_id")     // "ai" (null = system/auto)
  targetType     String?  @map("target_type")          // "đối tượng" — loại
  targetId       String?  @map("target_id")            // "đối tượng" — id
  before         Json? // "trước"
  after          Json? // "sau"
  occurredAt     DateTime @map("occurred_at") // "khi nào" (thời điểm nghiệp vụ)
  createdAt      DateTime @default(now()) @map("created_at") // khi ghi (server)

  @@index([actorAccountId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Mã đặt lại mật khẩu — LƯU HASH, không bao giờ lưu/đọc mã thô (mirror Session.refreshTokenHash,
/// AD-12). Mã entropy thấp (6 chữ số ≈ 20 bit) ⇒ an toàn dựa vào: TTL ngắn + single-use
/// (`consumedAt`) + trần số lần thử (`attemptCount`) + response trung tính. Vì entropy thấp,
/// hash bằng argon2id (KHÔNG SHA-256): nếu DB bị đọc, fast-hash của 10⁶ khả năng vỡ tức thì.
/// Tra cứu theo `accountId` (KHÔNG theo hash) — argon2 salt ngẫu nhiên nên hash không tra được,
/// và mã 6 số có thể trùng nhau giữa các account.
model PasswordResetCode {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash     String    @map("code_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("password_reset_codes")
}

/// Vật tư trong danh mục (FR-14). Giá bán `price` và giá vốn `costPrice` là **Int đồng**
/// (AD-10/AD-16) — KHÔNG Float/Decimal: tiền tính bằng số nguyên, làm tròn là quyết định
/// nghiệp vụ tường minh, không phải nhiễu dấu phẩy động.
///
/// `costPrice` là giá vốn HIỆN HÀNH, KHÔNG phải snapshot: đơn đã chốt đóng băng giá riêng
/// (`OrderLineItem.unitPriceSnapshot` lúc chốt, `costPriceSnapshot` lúc xuất kho — AD-20),
/// nên sửa giá ở đây KHÔNG hồi tố đơn cũ. Đọc/ghi `costPrice` gate bởi quyền `costs.view`
/// ở tầng app (AD-4) — DB không biết quyền.
///
/// Xoá = soft-delete (`isActive = false`), KHÔNG hard-delete: Epic 4 (`OrderLineItem`) và
/// Epic 6 (`StockItem`) sẽ FK vào bảng này; xoá cứng sẽ mồ côi dòng đơn/tồn kho lịch sử.
///
/// `tracksStock` = có theo dõi tồn (pin/inverter = true; công lắp/phí vận chuyển = false).
/// `priceEditable` = sale sửa được giá tại chỗ (phí lắp đặt = true; tấm pin = false —
/// mặc định an toàn, vì sửa giá là cửa sau né duyệt chiết khấu).
/// `warrantyMonths` nullable CÓ CHỦ ĐÍCH (công lắp không có bảo hành) — KHÔNG validate chặn null.
model Product {
  id             String         @id @default(uuid())
  name           String
  sku            String         @unique
  unit           String
  price          Int
  costPrice      Int            @map("cost_price")
  tracksStock    Boolean        @default(true) @map("tracks_stock")
  priceEditable  Boolean        @default(false) @map("price_editable")
  warrantyMonths Int?           @map("warranty_months")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  prices         ProductPrice[]
  groupItems     ProductGroupItem[]
  orderLineItems OrderLineItem[]

  @@map("products")
}

/// Bậc thang giá theo SỐ LƯỢNG (FR-15). `minQty` = mua TỪ bao nhiêu trở lên thì ăn mức này;
/// `price` là **Int đồng** (AD-10), như `Product.price`.
///
/// Bất biến `minQty >= 2` (ràng ở tầng app, DTO): giá gốc `Product.price` CHÍNH LÀ mức
/// `minQty = 1` ngầm định. Cho phép một dòng `minQty = 1` ở đây sẽ tạo HAI nguồn chân lý cho
/// giá gốc — và bất biến "cờ TẮT ⇒ mỗi sản phẩm một giá duy nhất" vỡ ngay.
///
/// KHÔNG có cột giá vốn: giá vốn là MỘT con số duy nhất trên `Product` (Story 6.3 ghi đè bằng
/// bình quân gia quyền lúc nhập kho). Bậc thang không nhân giá vốn lên (AD-20).
///
/// Hard-delete an toàn (khác `Product` soft-delete): báo cáo lợi nhuận chỉ đọc snapshot đã
/// đóng băng trên dòng đơn (`unitPriceSnapshot`/`costPriceSnapshot`), KHÔNG bao giờ join ngược
/// về đây. Bậc thang là nguồn PHÂN GIẢI LÚC ĐỌC, không phải dữ liệu lịch sử ⇒ `onDelete: Cascade`.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int      @map("min_qty")
  price     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, minQty])
  @@index([productId])
  @@map("product_prices")
}

/// Gói vật tư = một CHECKLIST sản phẩm con có thứ tự, KHÔNG phải một sản phẩm và KHÔNG phải một
/// dòng tự do. Người dựng báo giá chọn gói → tick từng món → mỗi món tick thành một dòng báo giá
/// bình thường trỏ vào `Product` THẬT.
///
/// Gói KHÔNG BAO GIỜ được lưu lên Đơn: không snapshot, không in PDF, không cột `productGroupId`
/// trên bảng đơn nào. Nó là công cụ NHẬP LIỆU, không phải dữ liệu của đơn hàng. Hệ quả: không
/// bảng nào FK vào đây ngoài `product_group_items`, nên bảng này không cần seed (danh mục gói
/// bắt đầu rỗng) và xoá cứng một gói cũng không mồ côi dữ liệu lịch sử nào.
///
/// `isActive` (soft-delete) theo quy ước của module `catalog/` — cùng khuôn `Product.isActive`,
/// KHÔNG phải `active` của `CustomerSource`. Tắt gói để rút nó khỏi picker mà vẫn bật lại được
/// theo mùa.
model ProductGroup {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  items       ProductGroupItem[]

  @@map("product_groups")
}

/// Một món trong gói — CHỈ trỏ `productId` + thứ tự hiện trên checklist.
///
/// KHÔNG có `defaultQty`/`qty`/`price`: số lượng do người dùng tự gõ lúc dựng báo giá, và giá là
/// giá của chính `Product` × số lượng. KHÔNG có giá trọn gói. Thêm cột định mức ở đây là mở cửa
/// cho BOM — thứ nằm NGOÀI phạm vi MVP.
///
/// `@@unique([productGroupId, productId])`: một sản phẩm không nằm hai lần trong cùng một gói
/// (tick hai lần cùng một món là vô nghĩa). Một sản phẩm VẪN nằm được ở NHIỀU gói khác nhau.
///
/// `onDelete: Cascade` trên gói — item không có đời sống riêng ngoài gói của nó (khuôn
/// `ProductPrice`). `onDelete: Restrict` trên sản phẩm — xoá cứng một `Product` đang nằm trong
/// gói phải bị CHẶN, kẻo checklist trỏ vào hư không.
model ProductGroupItem {
  id             String       @id @default(uuid())
  productGroupId String       @map("product_group_id")
  group          ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  displayOrder   Int          @map("display_order")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([productGroupId, productId])
  @@index([productGroupId])
  @@map("product_group_items")
}

/// Cờ tính năng cấp NGHIỆP VỤ, sống trên DB — KHÔNG Firebase Remote Config (AD-14: Remote
/// Config chỉ dành cho config cấp app của mobile; cờ nghiệp vụ là nguồn chân lý của backend).
///
/// Tên cờ CHÍNH LÀ khoá chính — không có cột `id` uuid riêng: một cờ là một cái tên, và
/// registry `feature-flags/domain/feature-flag-registry.ts` là nơi duy nhất khai tên đó.
///
/// VẮNG DÒNG = TẮT (fail-closed). Mặc định tắt là hệ quả của việc KHÔNG có dòng, không phải
/// một dòng seed phải nhớ tạo — bật cờ = `upsert`. Vì vậy bảng này rỗng lúc khởi tạo hệ thống
/// và điều đó là ĐÚNG, không phải thiếu seed.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Cấu hình hệ thống key-value — mirror khuôn `FeatureFlag`: bảng giữ TRẠNG THÁI, registry
/// (`settings/domain/setting-registry.ts`) giữ DANH SÁCH key hợp lệ + default. Row vắng =
/// dùng default từ registry (KHÔNG cần seed). `value` là String — parse theo kiểu ở service.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Nguồn khách — khách đến từ đâu (Facebook, Zalo, Đại lý…). Danh mục cấu hình được, seed 5
/// dòng ở story này; CRUD + màn cấu hình thuộc Story 3.5 (KHÔNG tạo lại bảng này ở đó).
///
/// `isOther` = CỜ nhận biết nguồn "Khác" — luật "chọn Khác thì bắt buộc ghi rõ" (`sourceNote`)
/// đọc CỜ này, KHÔNG so chuỗi `name === 'Khác'`: đổi tên hiển thị không được phép làm sập một
/// luật nghiệp vụ. Đúng MỘT dòng mang cờ này.
///
/// `sortOrder` để form khách hiển thị theo thứ tự nghiệp vụ, không theo thứ tự chèn.
model CustomerSource {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @map("sort_order")
  isOther     Boolean    @default(false) @map("is_other")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  customers   Customer[]
  orders      Order[]

  @@map("customer_sources")
  // Bất biến "đúng MỘT dòng isOther" được enforce bằng PARTIAL UNIQUE INDEX
  // `customer_sources_single_is_other` (migration 20260714000000, C-7). Prisma schema DSL không
  // biểu diễn được filtered index ⇒ nó sống trong migration SQL thủ công, KHÔNG ở đây. Đừng
  // tưởng "schema không thấy" là "không tồn tại": `\d customer_sources` trên DB sẽ thấy nó.
}

/// Khách hàng (FR-29). KHOÁ CHÍNH là **SĐT đã chuẩn hoá E.164** (`+84…`) — ngoại lệ DUY NHẤT
/// của quy ước "id UUID v4" (spine Conventions): một SĐT = một khách, trên toàn hệ thống.
/// Chuẩn hoá xảy ra ở backend qua `customers/domain/phone.ts` TRƯỚC khi chạm DB (AD-9); PK ở
/// đây vì vậy vừa là danh tính vừa là ràng buộc chống trùng — DB tự chặn, không phụ thuộc một
/// câu `if` ở tầng app nhớ chạy.
///
/// Hai LOẠI khách dùng CHUNG một bảng, cột nullable theo loại: `name`/`address` có ở cả hai;
/// `cccd` chỉ Cá nhân; `taxCode`/`bankAccount` chỉ Thương mại. Ràng buộc chéo-field (gửi
/// `taxCode` cho khách Cá nhân ⇒ 400) enforce ở TẦNG APP — DB không biết loại khách.
///
/// `custType` lưu **String** + validate `@IsIn` ở tầng app, KHÔNG Postgres enum — nhất quán
/// với `AccountPermission.permission`: registry evolve không cần migration enum.
///
/// `sourceId` BẮT BUỘC, không có mặc định: "khách này ở đâu ra" là câu hỏi nghiệp vụ phải trả
/// lời lúc tạo, không phải thứ hệ thống đoán hộ. Story 4.1 SNAPSHOT giá trị này sang
/// `Order.sourceId` **lúc TẠO đơn** (FR-35 — khách quay lại qua kênh khác thì đơn cũ vẫn giữ
/// kênh đã mang nó về) — nên ở đây nó luôn có giá trị để copy.
model Customer {
  sdt         String         @id
  custType    String         @map("cust_type")
  name        String
  cccd        String?
  taxCode     String?        @map("tax_code")
  address     String?
  bankAccount String?        @map("bank_account")
  sourceId    String         @map("source_id")
  source      CustomerSource @relation(fields: [sourceId], references: [id])
  sourceNote  String?        @map("source_note")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  orders      Order[]

  @@index([sourceId])
  @@map("customers")
}

/// Đơn hàng (Epic 4, AD-6). `Order` KHÔNG sở hữu line item nào trực tiếp — `OrderVersion` sở
/// hữu TẤT CẢ dòng, và `currentVersionId` là CON TRỎ CHÂN LÝ DUY NHẤT tới bản hiệu lực: mọi
/// đường đọc dòng phân giải qua nó, KHÔNG suy từ timestamp/đếm version.
///
/// `status` lưu **String** + validate tầng app (nhất quán `Customer.custType` — KHÔNG Postgres
/// enum); bộ khoá = `StatusKey` của chip design-system. Story 4.1 CHỈ gán `'baogia'` lúc INSERT;
/// mọi THAY ĐỔI status đi qua `applyTransition()` (Story 5.1, AD-11) — không UPDATE trần.
///
/// `sourceId` là **SNAPSHOT lúc TẠO đơn** copy từ `Customer.sourceId` (FR-35): khách quay lại
/// qua kênh khác thì `Customer.sourceId` đổi nhưng đơn cũ giữ nguyên kênh đã mang nó về —
/// cùng bài học `unitPriceSnapshot` (FR-5). `custType` cũng copy lúc tạo (nhãn báo cáo).
///
/// FK vòng với `OrderVersion`: `currentVersionId → order_versions.id` trong khi
/// `order_versions.order_id → orders.id` — hai named relation; tạo đơn = MỘT transaction 3 bước
/// với id sinh trước (order pointer null → version → repoint).
///
/// Cột hành-vi-story-sau tạo sẵn theo ERD nhưng 4.1 KHÔNG có hành vi: cờ phạm vi (preset 4.3),
/// `kWp`/`vatMode` (4.4).
model Order {
  id                String          @id @default(uuid())
  status            String
  customerSdt       String          @map("customer_sdt")
  customer          Customer        @relation(fields: [customerSdt], references: [sdt])
  currentVersionId  String?         @unique @map("current_version_id")
  currentVersion    OrderVersion?   @relation("OrderCurrentVersion", fields: [currentVersionId], references: [id])
  ownerAccountId    String          @map("owner_account_id")
  owner             Account         @relation("OrderOwner", fields: [ownerAccountId], references: [id])
  assigneeAccountId String?         @map("assignee_account_id")
  assignee          Account?        @relation("OrderAssignee", fields: [assigneeAccountId], references: [id])
  sourceId          String          @map("source_id")
  source            CustomerSource  @relation(fields: [sourceId], references: [id])
  custType          String          @map("cust_type")
  scopeThietBi      Boolean         @default(true) @map("scope_thiet_bi")
  scopeThiCong      Boolean         @default(false) @map("scope_thi_cong")
  scopeVanChuyen    Boolean         @default(false) @map("scope_van_chuyen")
  kWp               Float?          @map("k_wp")
  vatMode           String?         @map("vat_mode")
  validityNote      String?         @map("validity_note")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  versions          OrderVersion[]  @relation("OrderVersions")
  discountApprovals DiscountApproval[]
  quoteExport       QuoteExport?

  @@index([customerSdt])
  @@index([ownerAccountId])
  @@index([sourceId])
  @@map("orders")
}

/// Một BẢN của đơn — chủ sở hữu DUY NHẤT của line item (AD-6). 4.1 luôn tạo `versionNo = 1`;
/// sửa-sau-chốt đẻ version mới (4.6). `vatRate`/`vatMode`/`chotAt` null tới 4.4/4.5 —
/// `updatedAt` cần vì 4.5/4.6 sẽ ghi `chotAt`/`vatRate` lên row này.
/// `discountAmount` = snapshot chiết khấu ĐÃ DUYỆT ghi lúc Chốt (null = không chiết khấu);
/// version mới từ mở-lại KHÔNG mang chiết khấu — muốn giảm tiếp phải áp + duyệt lại.
model OrderVersion {
  id             String          @id @default(uuid())
  orderId        String          @map("order_id")
  order          Order           @relation("OrderVersions", fields: [orderId], references: [id])
  versionNo      Int             @map("version_no")
  vatRate        Int?            @map("vat_rate")
  vatMode        String?         @map("vat_mode")
  chotAt         DateTime?       @map("chot_at")
  discountAmount Int?            @map("discount_amount")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  lineItems      OrderLineItem[]
  currentOf      Order?          @relation("OrderCurrentVersion")
  discountApprovals DiscountApproval[]
  quoteExports   QuoteExport[]

  @@unique([orderId, versionNo])
  @@map("order_versions")
}

/// Dòng báo giá — thuộc MỘT `OrderVersion` (không bao giờ trỏ thẳng `Order`).
///
/// `productId` null = dòng tự do (tên/đơn vị/giá nhập tay). `onDelete: Restrict` TƯỜNG MINH:
/// default Prisma cho relation optional là SetNull — xoá Product sẽ âm thầm biến dòng catalog
/// thành "dòng tự do"; RESTRICT + `Product` soft-delete là đúng thiết kế (schema comment trên
/// `Product` đã hứa FK này từ Epic 3).
///
/// Tiền `Int` đồng (AD-10). `unitPrice` với dòng catalog `priceEditable=false` chỉ là CACHE lúc
/// nhập — đường đọc trả giá SỐNG từ danh mục tới khi Chốt (FR-5/FR-14); `unitPriceSnapshot`/
/// `catalogPriceSnapshot` null tới Chốt (4.5), `costPriceSnapshot` null tới xuất kho (6.4,
/// AD-20), `warrantyStartAt` null tới 4.9. `isFlexible` = cờ "linh động/dự kiến" — CHỈ hiển thị.
model OrderLineItem {
  id                   String       @id @default(uuid())
  orderVersionId       String       @map("order_version_id")
  orderVersion         OrderVersion @relation(fields: [orderVersionId], references: [id])
  productId            String?      @map("product_id")
  product              Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  name                 String
  unit                 String
  qty                  Int
  unitPrice            Int          @map("unit_price")
  priceEditable        Boolean      @default(false) @map("price_editable")
  isFlexible           Boolean      @default(false) @map("is_flexible")
  note                 String?
  warrantyMonths       Int?         @map("warranty_months")
  unitPriceSnapshot    Int?         @map("unit_price_snapshot")
  catalogPriceSnapshot Int?         @map("catalog_price_snapshot")
  costPriceSnapshot    Int?         @map("cost_price_snapshot")
  warrantyStartAt      DateTime?    @map("warranty_start_at")
  displayOrder         Int          @map("display_order")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([orderVersionId])
  @@index([productId])
  @@map("order_line_items")
}

/// Hồ sơ duyệt chiết khấu (FR-18, AD-18) — sống trong module orders vì áp/từ chối là hai
/// transition ghi `Order.status` (AD-11: mọi đường ghi status hội tụ về orders/domain).
///
/// `status` lưu **String** validate tầng app (`cho_duyet`/`dong_y`/`tu_choi` — khuôn
/// underscore của `vatMode`). Bất biến "một pending mỗi đơn" enforce bằng CỔNG STATUS
/// (áp chỉ đi từ `baogia` → `choduyet` atomic) — KHÔNG cần partial unique index.
///
/// `amount` là MỘT khoản Int đồng trên Đơn (AD-10, không per-line, không %).
/// `orderVersionId` = bản hiệu lực lúc áp — nội dung được duyệt chính là nội dung được chốt
/// (`assertMutable` đóng băng đơn suốt kỳ duyệt). Approval đã resolve nằm lại làm hồ sơ.
model DiscountApproval {
  id                   String       @id @default(uuid())
  orderId              String       @map("order_id")
  order                Order        @relation(fields: [orderId], references: [id])
  orderVersionId       String       @map("order_version_id")
  orderVersion         OrderVersion @relation(fields: [orderVersionId], references: [id])
  amount               Int
  status               String
  requestNote          String?      @map("request_note")
  resolveNote          String?      @map("resolve_note")
  requestedByAccountId String       @map("requested_by_account_id")
  requestedBy          Account      @relation("DiscountRequestedBy", fields: [requestedByAccountId], references: [id])
  resolvedByAccountId  String?      @map("resolved_by_account_id")
  resolvedBy           Account?     @relation("DiscountResolvedBy", fields: [resolvedByAccountId], references: [id])
  resolvedAt           DateTime?    @map("resolved_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([orderId])
  @@map("discount_approvals")
}

/// Hồ sơ xuất báo giá (FR-21, AD-3) — DB chỉ giữ METADATA + object key; bytes sống ở R2.
///
/// `orderId` @unique = bất biến "MỘT bộ file mới nhất mỗi Đơn": bấm Xuất lần n upsert đè
/// row này và ghi đè cùng object key trên R2 (`quotes/{orderId}/bao-gia.{png|pdf}`) —
/// file luôn phản ánh nội dung hiện tại của đơn, không rác R2, không lịch sử file
/// (lịch sử bản update là chuyện của OrderVersion).
///
/// `orderVersionId` = bản hiệu lực lúc xuất (hồ sơ "xuất từ bản nào");
/// `createdByAccountId` = ai bấm Xuất lần đầu (audit chi tiết từng lần nằm ở AuditLog
/// qua event QuoteExported, không ở đây).
model QuoteExport {
  id                 String       @id @default(uuid())
  orderId            String       @unique @map("order_id")
  order              Order        @relation(fields: [orderId], references: [id])
  orderVersionId     String       @map("order_version_id")
  orderVersion       OrderVersion @relation(fields: [orderVersionId], references: [id])
  imageKey           String       @map("image_key")
  pdfKey             String       @map("pdf_key")
  imageSize          Int          @map("image_size")
  pdfSize            Int          @map("pdf_size")
  fileName           String       @map("file_name")
  createdByAccountId String       @map("created_by_account_id")
  createdBy          Account      @relation("QuoteExportCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([orderVersionId])
  @@map("quote_exports")
}

/// Phiên đăng nhập — nơi refresh token sống để THU HỒI ĐƯỢC (AD-12). Chỉ lưu HASH
/// của refresh token (KHÔNG lưu token thô). Logout/rotate set `revokedAt`.
model Session {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("sessions")
}
