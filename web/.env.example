# Backend base URL the web client calls.
# Dev: keep /api — the vite dev server proxies it to the backend (VITE_PROXY_TARGET,
# default http://localhost:3000) and strips the /api prefix.
# Prod: the backend's full URL when the web is hosted on another origin
# (the backend must then list this web origin in CORS_ORIGINS).
VITE_API_BASE_URL=/api
